params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'
    debug = true

    // Limit resources so that this can run CI
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data
    fasta_read1    = 'tests/data/hydrop_scatac_1_S1_R1_001.fastq.gz'
    fasta_read2    = 'tests/data/hydrop_scatac_1_S1_R3_001.fastq.gz'
    fasta_barcodes = 'tests/data/hydrop_scatac_1_S1_R2_001.fastq.gz'
}
