#!/bin/sh
# Auto-format with isort then black before every commit.
#
# Runs the project's formatters, in this order:
#     isort .   then   black .
# Both read their configuration from pyproject.toml ([tool.isort] uses the
# black profile, so the two never fight). Ruff is deliberately NOT run here —
# lint findings are reviewed by hand.
#
# Only files that were ALREADY staged get re-staged after formatting, so a
# whole-repo format never drags unrelated files into the commit. A file that is
# partially staged (staged changes plus further unstaged edits) is left alone
# and reported, because re-adding it would silently commit the unstaged work.
#
# Requires the project's dev tools:  pip install -e ".[dev]"
# Bypass for one commit with:         git commit --no-verify

# Nothing Python staged? Nothing to do — also keeps docs-only and merge commits
# working when the formatters aren't installed.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '\.pyi?$')
[ -n "$staged" ] || exit 0

for tool in isort black; do
    command -v "$tool" >/dev/null 2>&1 && continue
    echo "pre-commit: '$tool' not found on PATH. Install the dev tools with" >&2
    echo "            'pip install -e \".[dev]\"', or skip with 'git commit --no-verify'." >&2
    exit 1
done

# Files whose worktree content differs from the index — formatting them would
# mix unstaged edits into the commit, so they are skipped below.
partial=$(git diff --name-only --diff-filter=ACMR -z | tr '\0' '\n' | grep -E '\.pyi?$')

isort . || exit 1
black . || exit 1

echo "$staged" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    if echo "$partial" | grep -qxF "$file"; then
        echo "pre-commit: '$file' is partially staged — formatting applied to the" >&2
        echo "            worktree but NOT staged; review and re-add it yourself." >&2
        continue
    fi
    [ -e "$file" ] && git add -- "$file"
done

exit 0
